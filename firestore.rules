rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "jafor99a@gmail.com";
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function tournamentPath(tid) {
      return /databases/$(database)/documents/tournaments/$(tid);
    }

    function joinPath(tid, uid) {
      return /databases/$(database)/documents/tournamentJoins/$(tid + "_" + uid);
    }

    function validJoinTransaction(tid, uid) {
      let ub = get(userPath(uid)).data;
      let ua = getAfter(userPath(uid)).data;
      let tb = get(tournamentPath(tid)).data;
      let ta = getAfter(tournamentPath(tid)).data;
      let ja = getAfter(joinPath(tid, uid)).data;

      return self(uid)
        && exists(userPath(uid))
        && exists(tournamentPath(tid))
        && !exists(joinPath(tid, uid))
        && tb.status == 'open'
        && tb.entryFee is int
        && tb.entryFee >= 0
        && tb.entryFee <= 1000
        && tb.slots is int
        && tb.slots >= 1
        && tb.slots <= 100
        && tb.joinCount is int
        && tb.joinCount < tb.slots
        && ub.demoBalance is int
        && ub.demoBalance >= tb.entryFee
        && ua.demoBalance == ub.demoBalance - tb.entryFee
        && ua.lastEntryTournamentId == tid
        && ta.joinCount == tb.joinCount + 1
        && ja.userId == uid
        && ja.tournamentId == tid
        && ja.status == 'joined'
        && ja.playerName is string
        && ja.playerName.size() >= 2
        && ja.playerName.size() <= 60
        && ja.freeFireUid is string
        && ja.freeFireUid.matches('^[0-9]{5,20}$');
    }

    function validEntryTransaction(uid) {
      let tid = request.resource.data.lastEntryTournamentId;
      let before = resource.data;
      let after = request.resource.data;
      let tb = get(tournamentPath(tid)).data;
      let ja = getAfter(joinPath(tid, uid)).data;

      return self(uid)
        && tid is string
        && after.diff(before).affectedKeys()
             .hasOnly(['demoBalance', 'lastEntryTournamentId'])
        && after.diff(before).affectedKeys()
             .hasAll(['demoBalance', 'lastEntryTournamentId'])
        && exists(tournamentPath(tid))
        && tb.entryFee is int
        && before.demoBalance is int
        && after.demoBalance is int
        && after.demoBalance == before.demoBalance - tb.entryFee
        && after.demoBalance >= 0
        && existsAfter(joinPath(tid, uid))
        && ja.userId == uid
        && ja.tournamentId == tid
        && ja.status == 'joined'
        && existsAfter(tournamentPath(tid))
        && getAfter(tournamentPath(tid)).data.joinCount
             == tb.joinCount + 1;
    }

    match /users/{uid} {
      allow create: if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.demoBalance == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow read: if self(uid) || isAdmin();

      allow update: if isAdmin()
        || (
          self(uid)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['displayName', 'email', 'lastLoginAt'])
          && request.resource.data.email == request.auth.token.email
        )
        || validEntryTransaction(uid);

      allow delete: if isAdmin();
    }

    match /tournaments/{tid} {
      allow read: if signedIn();

      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 100
        && request.resource.data.mode in ['SOLO', 'DUO', 'SQUAD']
        && request.resource.data.map is string
        && request.resource.data.entryFee is int
        && request.resource.data.entryFee >= 0
        && request.resource.data.entryFee <= 1000
        && request.resource.data.prizePool is int
        && request.resource.data.prizePool >= 0
        && request.resource.data.prizePool <= 100000
        && request.resource.data.slots is int
        && request.resource.data.slots >= 1
        && request.resource.data.slots <= 100
        && request.resource.data.joinCount == 0
        && request.resource.data.status == 'open'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['joinCount'])
          && request.resource.data.joinCount == resource.data.joinCount + 1
          && validJoinTransaction(tid, request.auth.uid)
        );

      allow delete: if isAdmin();
    }

    match /tournamentJoins/{joinId} {
      allow create: if signedIn()
        && request.resource.data.tournamentId is string
        && joinId == request.resource.data.tournamentId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'tournamentId', 'tournamentTitle',
          'playerName', 'freeFireUid', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'tournamentId', 'playerName',
          'freeFireUid', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'joined'
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 2
        && request.resource.data.playerName.size() <= 60
        && request.resource.data.freeFireUid is string
        && request.resource.data.freeFireUid.matches('^[0-9]{5,20}$')
        && request.resource.data.createdAt == request.time
        && validJoinTransaction(
          request.resource.data.tournamentId,
          request.auth.uid
        );

      allow read: if signedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /tournamentRooms/{tid} {
      allow read: if isAdmin()
        || (
          signedIn()
          && exists(joinPath(tid, request.auth.uid))
          && get(joinPath(tid, request.auth.uid)).data.userId
               == request.auth.uid
        );

      allow create, update: if isAdmin()
        && request.resource.data.tournamentId == tid
        && request.resource.data.roomId is string
        && request.resource.data.roomPassword is string
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /tournamentResults/{resultId} {
      allow read: if signedIn();

      allow create: if isAdmin()
        && request.resource.data.tournamentId is string
        && request.resource.data.title is string
        && request.resource.data.winner is string
        && request.resource.data.position is string
        && request.resource.data.prize is int
        && request.resource.data.prize >= 0
        && request.resource.data.prize <= 100000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}